{
  "name": "kinetix-mobile",
  "version": "1.0.0",
  "main": "./index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "expo": "~58.0.26",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.0",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "lightningcss": "1.30.1",
    "nativewind": "^5.0.0-rc.1",
    "postcss": "^8.5.33",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "^3.1.0-rc.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "share:device": "npm run build:release && cp android/app/build/outputs/apk/release/app-release.apk ../kinetix.apk && adb install -r android/app/build/outputs/apk/release/app-release.apk && npm run app:launch && echo '✅ Installed on your phone and ready to share at kinetix.apk'",
    "install:device": "adb install -r android/app/build/outputs/apk/release/app-release.apk && npm run app:launch",
    "build:release": "cd android && ./gradlew assembleRelease",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:share": "npm run build:release && cp android/app/build/outputs/apk/release/app-release.apk ../kinetix.apk && echo '✅ Shareable APK ready at kinetix.apk'",
    "app:launch": "adb shell monkey -p com.anonymous.mobilefrontend -c android.intent.category.LAUNCHER 1",
    "test": "jest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-asset.js"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
